{
  "images": {
    "sizes": [
      320,
      480,
      640,
      828,
      1080,
      1200,
      1920
    ],
    "domains": [
      "images.unsplash.com",
      "pmiubsqfjeyxvrobaecn.supabase.co"
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2592000
  },
  "buildCommand": "npm run build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "outputDirectory": "dist",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.kloversegy.com"
        }
      ],
      "destination": "https://kloversegy.com/$1",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/?lang=en",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*?lang=en",
      "permanent": true
    },
    {
      "source": "/hangul-guide",
      "destination": "/blog/learn-korean-alphabet-hangul-guide",
      "permanent": true
    },
    {
      "source": "/kdrama-learning",
      "destination": "/learn-korean-kdramas",
      "permanent": true
    },
    {
      "source": "/topik-guide",
      "destination": "/topik-exam-preparation",
      "permanent": true
    },
    {
      "source": "/blog/ar-korean-daily-greetings",
      "destination": "/blog/korean-daily-greetings-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-korean-food-vocabulary",
      "destination": "/blog/korean-food-vocabulary-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-korean-grammar-particles",
      "destination": "/blog/korean-grammar-particles-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-korean-numbers-guide",
      "destination": "/blog/korean-numbers-guide-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-korean-slang-words",
      "destination": "/blog/korean-slang-words-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-seoul-travel-korean-phrases",
      "destination": "/blog/seoul-travel-korean-phrases-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-study-korean-kdramas-method",
      "destination": "/blog/study-korean-kdramas-method-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-topik-exam-guide",
      "destination": "/blog/topik-exam-guide-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-korean-cafe-culture",
      "destination": "/blog/korean-cafe-coffee-culture-ar",
      "permanent": true
    },
    {
      "source": "/blog/ar-learn-korean-alphabet-hangul",
      "destination": "/blog/learn-korean-alphabet-hangul-guide-ar",
      "permanent": true
    },
    {
      "source": "/blog/korean-learning-apps-comparison-2026-ar",
      "destination": "/blog/korean-learning-apps-comparison-2026-duolingo-rosetta-stone-ar",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-not-found"
    },
    {
      "source": "/(ar|ar/courses|ar/pricing|ar/about|ar/faq|ar/placement-test|ar/free-trial|ar/blog|courses|pricing|about|faq|contact|privacy-policy|privacy|terms|signup|login|forgot-password|reset-password|enroll|enroll-now|my-lessons|pay/[^/]+|blog|journey/[^/]+|resubmit-schedule|placement-test|unit-placement|games|world|dashboard|dashboard/[^/]+|textbook|textbook/[^/]+|textbook/[^/]+/[^/]+|review|daily-quiz|profile|complete-profile|free-trial|rsvp|trial-booking|progress-report|certificate|affiliate|learn-korean-arabic-speakers|topik-exam-preparation|learn-korean-kdramas|interview-training|welcome-back|hangul-book|trial-book|trial-confirm|enrollment-status|hangul-starter|shop|shop/[^/]+|shop/products/[^/]+|c/[^/]+|gift/cluby|practice-interview|unsubscribe|admin|admin/[^/]+)",
      "destination": "/app.html"
    },
    {
      "source": "/((?!api|assets|videos|klovers-logo\\.jpg|klovers-mascot\\.svg|instagram-posts\\.html|favicon\\.ico|placeholder\\.svg|robots\\.txt|sitemap\\.xml|manifest\\.json|sw\\.js|app\\.html|8f8e25f6c4d7b10abab899f355a7e529\\.txt).*)",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://files.stripe.com https://images.unsplash.com https://*.supabase.co https://www.google-analytics.com https://www.facebook.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://fonts.googleapis.com https://connect.facebook.net wss://*.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/forgot-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/:path*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false
}
